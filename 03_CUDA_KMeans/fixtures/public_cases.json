      "expected_centroids": [[6], [31]],
      "expected_update_count": 3,
      "expected_converged": true,
      "expected_inertia": 184.0
    },
    {
      "name": "update_cap_without_hidden_update",
      "purpose": "same points as three_updates, capped at one update; final labels need not match centroid means",
      "k": 2,
      "max_updates": 1,
      "initial_rows": [4, 12],
